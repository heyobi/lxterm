          "stringUnit": {
            "state": "translated",
            "value": "Sil ve yeniden indir"
          }
        }
      }
    },
    "Everything installed or changed in it is deleted and a fresh copy is downloaded. Its tabs are closed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçinde kurulan ya da değiştirilen her şey silinir ve temiz bir kopya indirilir. Sekmeleri kapanır."
