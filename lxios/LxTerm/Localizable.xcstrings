{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Preparing Debian": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian hazırlanıyor"
          }
        }
      }
    },
    "Debian 13 is unpacked onto this iPhone once. It takes a few seconds.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian 13 bu iPhone'a bir kez açılır. Birkaç saniye sürer."
          }
        }
      }
    },
    "Debian could not be prepared": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian hazırlanamadı"
          }
        }
      }
    },
    "Second shell": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci kabuk"
          }
        }
      }
    },
    "New shell": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kabuk"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        }
      }
    },
    "Close shell": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabuğu kapat"
          }
        }
      }
    },
    "[the shell has ended — tap to start a new one]": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[kabuk kapandı — yenisini başlatmak için dokunun]"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı"
          }
        }
      }
    },
    "Size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut"
          }
        }
      }
    },
    "Pinch the terminal to change the size too.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutu terminalde iki parmakla da değiştirebilirsiniz."
          }
        }
      }
    },
    "Colours": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renkler"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        }
      }
    },
    "Night": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece"
          }
        }
      }
    },
    "Paper": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kâğıt"
          }
        }
      }
    },
    "Solarized": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solarized"
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehribar"
          }
        }
      }
    },
    "Reset Debian…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'ı sıfırla…"
          }
        }
      }
    },
    "Erases everything installed or changed in Debian and unpacks a fresh system. Use it if the system no longer starts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'da kurulan ya da değiştirilen her şeyi siler ve sistemi yeniden açar. Sistem artık başlamıyorsa kullanın."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "Debian's own arm64 programs, unmodified, run on this iPhone in a no-JIT AArch64 interpreter with a Linux system-call layer. Not affiliated with the Debian Project.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'ın kendi arm64 programları, değiştirilmeden, bu iPhone'da JIT'siz bir AArch64 yorumlayıcısı ve Linux sistem çağrısı katmanıyla çalışır. Debian Projesi ile bağlantılı değildir."
          }
        }
      }
    },
    "Source code (GPL-3.0)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak kodu (GPL-3.0)"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik"
          }
        }
      }
    },
    "Licenses": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisanslar"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Reset Debian?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian sıfırlansın mı?"
          }
        }
      }
    },
    "Erase and unpack again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil ve yeniden aç"
          }
        }
      }
    },
    "Installed packages, your files in Debian and open shells are deleted.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu paketler, Debian'daki dosyalarınız ve açık kabuklar silinir."
          }
        }
      }
    },
    "Hide keyboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi gizle"
          }
        }
      }
    },
    "Show or hide the keyboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi göster ya da gizle"
          }
        }
      }
    },
    "Debian package sources": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian paketlerinin kaynak kodu"
          }
        }
      }
    },
    "Accelerated engine (beta)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlandırılmış motor (beta)"
          }
        }
      }
    },
    "New tabs (marked ⚡) run Debian in WebKit's WebAssembly engine, which compiles programs as they run: long jobs are several times faster. It starts from a copy of your system and keeps its own from then on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sekmeler (⚡ ile işaretli) Debian'ı WebKit'in WebAssembly motorunda çalıştırır; programlar çalışırken derlenir, uzun işler birkaç kat hızlıdır. Sisteminizin bir kopyasıyla başlar, sonra kendi kopyasını tutar."
          }
        }
      }
    },
    "The accelerated engine was stopped by iOS (memory). Tap to start again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlandırılmış motor iOS tarafından durduruldu (bellek). Yeniden başlatmak için dokunun."
          }
        }
      }
    },
    "Could not copy the file: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kopyalanamadı: %@"
          }
        }
      }
    },
    "File received: /root/Files/%@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya alındı: /root/Files/%@"
          }
        }
      }
    },
    "Browser for servers in Debian": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'daki sunucular için tarayıcı"
          }
        }
      }
    },
    "Reload": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenile"
          }
        }
      }
    },
    "The download failed (HTTP %lld, %@).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme başarısız oldu (HTTP %lld, %@)."
          }
        }
      }
    },
    "The image has no arm64 version.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görüntünün arm64 sürümü yok."
          }
        }
      }
    },
    "The checksum of %@ does not match: the download was not used.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sağlama toplamı tutmuyor: indirilen dosya kullanılmadı."
          }
        }
      }
    },
    "Unsupported image format: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmeyen görüntü biçimi: %@"
          }
        }
      }
    },
    "Could not unpack: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılamadı: %@"
          }
        }
      }
    },
    "Each is the project's own official arm64 image, unmodified, downloaded from Docker Hub and checked against its SHA-256 digest. Once downloaded, choose it from + when opening a tab. Unofficial: not affiliated with or endorsed by these projects.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri projenin kendi resmi arm64 görüntüsüdür; değiştirilmeden Docker Hub'dan indirilir ve SHA-256 özetiyle doğrulanır. İndirdikten sonra yeni sekme açarken + menüsünden seçin. Resmi değildir: bu projelerle bağlantılı değildir, onlarca desteklenmez."
          }
        }
      }
    },
    "Distributions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dağıtımlar"
          }
        }
      }
    },
    "Download failed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme başarısız"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "Remove %@?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kaldırılsın mı?"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldır"
          }
        }
      }
    },
    "Everything installed or changed in it is deleted, and its tabs are closed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçinde kurulan ya da değiştirilen her şey silinir, sekmeleri kapanır."
          }
        }
      }
    },
    "%@ · included": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · uygulamayla gelir"
          }
        }
      }
    },
    "%@ · about %lld MB download": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · yaklaşık %lld MB indirme"
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aç"
          }
        }
      }
    },
    "Download": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndir"
          }
        }
      }
    },
    "Ports: servers running in the shells": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portlar: kabuklarda çalışan sunucular"
          }
        }
      }
    },
    "Get more…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka dağıtım indir…"
          }
        }
      }
    },
    "No servers are running.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan sunucu yok."
          }
        }
      }
    },
    "Start one in a shell and it appears here, for example:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kabukta sunucu başlatın, burada görünür. Örneğin:"
          }
        }
      }
    },
    "Servers listening in your shells. They keep running while LxTerm is open.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabuklarınızda dinleyen sunucular. LxTerm açık kaldıkça çalışmaya devam ederler."
          }
        }
      }
    },
    "Other port": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka port"
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        }
      }
    },
    "Ports": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portlar"
          }
        }
      }
    },
    "Port %@ is open": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %@ açıldı"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "Nothing answers here": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yanıt veren yok"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dene"
          }
        }
      }
    },
    "No server is listening on this port. Start one in a shell, then try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu portta dinleyen sunucu yok. Bir kabukta başlatıp tekrar deneyin."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri"
          }
        }
      }
    },
    "Forward": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleri"
          }
        }
      }
    },
    "Ubuntu, Alpine Linux, Fedora, AlmaLinux, Rocky Linux and openSUSE can be downloaded for new tabs, beside Debian.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'ın yanında yeni sekmeler için Ubuntu, Alpine Linux, Fedora, AlmaLinux, Rocky Linux ve openSUSE de indirilebilir."
          }
        }
      }
    },
    "Automatic (light or dark, as the iPhone)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik (iPhone'a göre açık ya da koyu)"
          }
        }
      }
    },
    "Function keys": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonksiyon tuşları"
          }
        }
      }
    },
    "Home": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "End": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "End"
          }
        }
      }
    },
    "Page Up": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page Up"
          }
        }
      }
    },
    "Page Down": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page Down"
          }
        }
      }
    },
    "Reset %@?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sıfırlansın mı?"
          }
        }
      }
    },
    "Erase and download again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil ve yeniden indir"
          }
        }
      }
    },
    "Everything installed or changed in it is deleted and a fresh copy is downloaded. Its tabs are closed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçinde kurulan ya da değiştirilen her şey silinir ve temiz bir kopya indirilir. Sekmeleri kapanır."
          }
        }
      }
    },
    "Reset": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırla"
          }
        }
      }
    },
    "Reset…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırla…"
          }
        }
      }
    }
  }
}