    },
    "Exchange rates every morning": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sabah döviz kurları"
          }
        }
      }
    },
    "Run Saved Command: Exchange rates → Show Notification": {
      "localizations": {
        "tr": {
