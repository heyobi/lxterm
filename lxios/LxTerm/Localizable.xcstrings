    "Opens a new tab in the chosen distribution and runs the command in it, as if typed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dağıtımda yeni bir sekme açar ve komutu yazılmış gibi çalıştırır."
          }
        }
      }
    },
    "Run Command and Get Output": {
      "localizations": {
