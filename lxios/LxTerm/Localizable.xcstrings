{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Preparing Debian": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian hazırlanıyor"
          }
        }
      }
    },
    "Debian 13 is unpacked onto this iPhone once. It takes a few seconds.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian 13 bu iPhone'a bir kez açılır. Birkaç saniye sürer."
          }
        }
      }
    },
    "Debian could not be prepared": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian hazırlanamadı"
          }
        }
      }
    },
    "Second shell": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci kabuk"
          }
        }
      }
    },
    "New shell": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kabuk"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        }
      }
    },
    "Close shell": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabuğu kapat"
          }
        }
      }
    },
    "[the shell has ended — tap to start a new one]": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[kabuk kapandı — yenisini başlatmak için dokunun]"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı"
          }
        }
      }
    },
    "Size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut"
          }
        }
      }
    },
    "Pinch the terminal to change the size too.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutu terminalde iki parmakla da değiştirebilirsiniz."
          }
        }
      }
    },
    "Colours": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renkler"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        }
      }
    },
    "Night": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece"
          }
        }
      }
    },
    "Paper": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kâğıt"
          }
        }
      }
    },
    "Solarized": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solarized"
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehribar"
          }
        }
      }
    },
    "Reset Debian…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'ı sıfırla…"
          }
        }
      }
    },
    "Erases everything installed or changed in Debian and unpacks a fresh system. Use it if the system no longer starts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'da kurulan ya da değiştirilen her şeyi siler ve sistemi yeniden açar. Sistem artık başlamıyorsa kullanın."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "Debian's own arm64 programs, unmodified, run on this iPhone in a no-JIT AArch64 interpreter with a Linux system-call layer. Not affiliated with the Debian Project.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian'ın kendi arm64 programları, değiştirilmeden, bu iPhone'da JIT'siz bir AArch64 yorumlayıcısı ve Linux sistem çağrısı katmanıyla çalışır. Debian Projesi ile bağlantılı değildir."
          }
        }
      }
    },
    "Source code (GPL-3.0)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak kodu (GPL-3.0)"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik"
          }
        }
      }
    },
    "Licenses": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisanslar"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Reset Debian?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian sıfırlansın mı?"
          }
        }
      }
    },
    "Erase and unpack again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil ve yeniden aç"
          }
        }
      }
    },
    "Installed packages, your files in Debian and open shells are deleted.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu paketler, Debian'daki dosyalarınız ve açık kabuklar silinir."
          }
        }
      }
    },
    "Hide keyboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi gizle"
          }
        }
      }
    },
    "Show or hide the keyboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi göster ya da gizle"
          }
        }
      }
    },
    "Debian package sources": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debian paketlerinin kaynak kodu"
          }
        }
      }
    },
    "Accelerated engine (beta)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlandırılmış motor (beta)"
          }
        }
      }
    },
    "New tabs (marked ⚡) run Debian in WebKit's WebAssembly engine, which compiles programs as they run: long jobs are several times faster. It starts from a copy of your system and keeps its own from then on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sekmeler (⚡ ile işaretli) Debian'ı WebKit'in WebAssembly motorunda çalıştırır; programlar çalışırken derlenir, uzun işler birkaç kat hızlıdır. Sisteminizin bir kopyasıyla başlar, sonra kendi kopyasını tutar."
          }
        }
      }
    },
    "The accelerated engine was stopped by iOS (memory). Tap to start again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlandırılmış motor iOS tarafından durduruldu (bellek). Yeniden başlatmak için dokunun."
          }
        }
      }
    }
  }
}
