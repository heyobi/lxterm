            "state": "translated",
            "value": "Kopyalandı"
          }
        }
      }
    },
    "Tap a command to type it into the shown tab. Swipe to edit or delete.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komuta dokunun, açık sekmeye yazılsın. Düzenlemek ya da silmek için kaydırın."
