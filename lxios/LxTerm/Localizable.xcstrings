        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komuta standart girdisinden verilen metin."
          }
        }
      }
    },
    "Exchange rates": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döviz kurları"
          }
        }
      }
    },
    "Save a note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not kaydet"
