      }
    },
    "Runs the command in the chosen distribution and returns what it printed, for the next actions of a shortcut. It stops after the time limit.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komutu seçilen dağıtımda çalıştırır ve yazdıklarını kısayolun sonraki adımlarına verir. Süre sınırında durur."
          }
        }
      }
    },
    "Distribution": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dağıtım"
          }
        }
      }
    },
    "Time limit (seconds)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre sınırı (saniye)"
          }
        }
      }
    },
    "Run %@ in %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ komutunu %@ içinde çalıştır"
          }
        }
      }
    },
    "Open LxTerm once first: Debian is unpacked on the first start.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce LxTerm'i bir kez açın: Debian ilk açılışta kurulur."
          }
        }
      }
    },
    "%@ is not downloaded. Download it in LxTerm › Settings › Distributions.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ indirilmemiş. LxTerm › Ayarlar › Dağıtımlar'dan indirin."
          }
        }
      }
    },
    "The command could not be started.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut başlatılamadı."
          }
        }
      }
    },
    "Run Command": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut Çalıştır"
          }
        }
      }
    },
    "Run in a Tab": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekmede Çalıştır"
          }
        }
      }
    },
    "Font": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı tipi"
          }
        }
      }
