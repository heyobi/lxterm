    "Cursor": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleç"
          }
        }
      }
    },
    "Block": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blok"
          }
        }
